# ═══════════════════════════════════════════════════════════════════════════════
# BisnisSehat - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# For Supabase Edge Function secrets, use: supabase secrets set KEY=VALUE
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# Supabase Configuration (Frontend)
# ═══════════════════════════════════════════════════════════════════════════════
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Midtrans Client Key (safe for frontend — Sandbox)
# Get from: https://dashboard.midtrans.com → Settings → Access Keys
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXX

# ═══════════════════════════════════════════════════════════════════════════════
# Midtrans Payment Integration (Edge Function Secrets)
# ═══════════════════════════════════════════════════════════════════════════════
# Set these via: supabase secrets set KEY=VALUE
# Sandbox dashboard: https://dashboard.sandbox.midtrans.com
# ═══════════════════════════════════════════════════════════════════════════════

# Midtrans Server Key (SECRET — never expose to frontend)
# Get from: https://dashboard.sandbox.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXX

# Midtrans Client Key (safe for frontend — set in .env as VITE_*)
# Already defined above as VITE_MIDTRANS_CLIENT_KEY

# Production mode: false = sandbox, true = production
MIDTRANS_IS_PRODUCTION=false

# Notification Webhook URL (configure in Midtrans Dashboard):
# https://<project-ref>.supabase.co/functions/v1/midtrans-notification

# ═══════════════════════════════════════════════════════════════════════════════
# Marketplace Integration (Edge Function Secrets)
# ═══════════════════════════════════════════════════════════════════════════════
# Set these via: supabase secrets set KEY=VALUE
# See: https://supabase.com/docs/guides/functions/secrets
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Shopee Open Platform
# ─────────────────────────────────────────────────────────────────────────────
# Register at: https://open.shopee.co.id
# Documentation: https://open.shopee.com/developer-guide/auth
#
# Steps:
# 1. Login to Shopee Open Platform with your seller account
# 2. Click "Create New App"
# 3. Fill in app details:
#    - App Name: BisnisSehat
#    - Description: Aplikasi manajemen bisnis UMKM
#    - Callback URL: https://<project-ref>.supabase.co/functions/v1/marketplace-oauth/callback
# 4. Select scopes: shop_info, product, order
# 5. Submit for review (1-7 business days)
# 6. After approval, get Partner ID and Partner Key
# ─────────────────────────────────────────────────────────────────────────────
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:5173/dashboard/operasional/marketplace/callback

# ─────────────────────────────────────────────────────────────────────────────
# Tokopedia Developer Portal
# ─────────────────────────────────────────────────────────────────────────────
# Register at: https://developer.tokopedia.com
# Documentation: https://developer.tokopedia.com/doc/
#
# Steps:
# 1. Login to Tokopedia Developer Portal with your seller account
# 2. Click "Create App"
# 3. Fill in app details:
#    - App Name: BisnisSehat
#    - Callback URL: https://<project-ref>.supabase.co/functions/v1/marketplace-oauth/callback
# 4. Select scopes: read_products, write_products, read_orders, write_orders
# 5. Submit for review
# 6. After approval, get Client ID and Client Secret
# ─────────────────────────────────────────────────────────────────────────────
TOKOPEDIA_CLIENT_ID=
TOKOPEDIA_CLIENT_SECRET=
TOKOPEDIA_REDIRECT_URI=http://localhost:5173/dashboard/operasional/marketplace/callback

# ─────────────────────────────────────────────────────────────────────────────
# TikTok Shop Partner Center
# ─────────────────────────────────────────────────────────────────────────────
# Register at: https://partner.tiktokshop.com
# Documentation: https://partner.tiktokshop.com/docv2/page/6507ead7b99d5302be949ba9
#
# Steps:
# 1. Login to TikTok Shop Partner Center with your seller account
# 2. Click Develop → Create App
# 3. Fill in app details:
#    - App Name: BisnisSehat
#    - Callback URL: https://<project-ref>.supabase.co/functions/v1/marketplace-oauth/callback
# 4. Select required scopes
# 5. Submit for review
# 6. After approval, get App Key and App Secret
# ─────────────────────────────────────────────────────────────────────────────
TIKTOKSHOP_APP_KEY=
TIKTOKSHOP_APP_SECRET=
TIKTOKSHOP_REDIRECT_URI=http://localhost:5173/dashboard/operasional/marketplace/callback

# ─────────────────────────────────────────────────────────────────────────────
# Encryption Key (Required)
# ─────────────────────────────────────────────────────────────────────────────
# Used to encrypt marketplace tokens (AES-256-GCM)
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
MARKETPLACE_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Competitor Analysis (Edge Function Secrets)
# ═══════════════════════════════════════════════════════════════════════════════
# Set these via: supabase secrets set KEY=VALUE
# See: https://supabase.com/docs/guides/functions/secrets
# ═══════════════════════════════════════════════════════════════════════════════

# Serper.dev API Key (for Google search)
# Get free API key from: https://serper.dev
# Free tier: 2,500 searches/month
SERPER_API_KEY=

# SerpAPI Key (alternative search and website scraping)
# Get free API key from: https://serpapi.com
# Free tier: 100 searches/month
SERPAPI_KEY=

# Browserless API Key (website content scraping)
# Get API key from: https://browserless.io
# Alternative: Use browserless Docker locally
BROWSER_API_KEY=

# Gemini API Key (for AI analysis)
# Get free API key from: https://aistudio.google.com/app/apikey
# Free tier: 60 requests/minute
GEMINI_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# WhatsApp Integration (Baileys Connector)
# ═══════════════════════════════════════════════════════════════════════════════
#
# WhatsApp uses Baileys (self-hosted) for persistent connection.
# This requires a separate Node.js service running on port 3001.
#
# For the connector service, use environment variables:
#   - SUPABASE_URL: Your Supabase project URL
#   - SUPABASE_SERVICE_KEY: Your Supabase service role key
#   - WHATSAPP_ENCRYPTION_KEY: 32-byte hex key for encrypting credentials
#   - WHATSAPP_CONNECTOR_PORT: Port for the connector (default: 3001)
#
# ─────────────────────────────────────────────────────────────────────────────
# Frontend Environment (VITE_)
# ─────────────────────────────────────────────────────────────────────────────
# URL of the WhatsApp connector service (Baileys)
VITE_WHATSAPP_CONNECTOR_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Encryption Key (for Supabase storage)
# ─────────────────────────────────────────────────────────────────────────────
# Used to encrypt WhatsApp credentials stored in Supabase
# Generate with: openssl rand -hex 32
WHATSAPP_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Google Business Profile Integration (Edge Function Secrets)
# ═══════════════════════════════════════════════════════════════════════════════
# Set these via: supabase secrets set KEY=VALUE
# See: https://supabase.com/docs/guides/functions/secrets
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Google Cloud OAuth 2.0
# ─────────────────────────────────────────────────────────────────────────────
# Prerequisites:
# 1. Create/select project at: https://console.cloud.google.com
# 2. Enable APIs:
#    - My Business Account Management API
#    - My Business Business Information API
#    - Google My Business API (for Reviews & Local Posts)
#    - Business Profile Performance API
# 3. Configure OAuth Consent Screen (External user type)
#    Add scopes: https://www.googleapis.com/auth/business.manage
# 4. Create OAuth Client ID (Web Application)
# 5. Add authorized redirect URI
# 6. Submit for Google review/approval
#
# Get values from: https://console.cloud.google.com → APIs & Credentials
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/google-business-callback

# ═══════════════════════════════════════════════════════════════════════════════
# Quick Setup Commands
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. Generate encryption key:
#    ENCRYPTION_KEY=$(openssl rand -hex 32)
#
# 2. Set all marketplace secrets at once:
#    supabase secrets set \
#      SHOPEE_PARTNER_ID="your-value" \
#      SHOPEE_PARTNER_KEY="your-value" \
#      SHOPEE_REDIRECT_URI="http://localhost:5173/dashboard/operasional/marketplace/callback" \
#      TOKOPEDIA_CLIENT_ID="your-value" \
#      TOKOPEDIA_CLIENT_SECRET="your-value" \
#      TOKOPEDIA_REDIRECT_URI="http://localhost:5173/dashboard/operasional/marketplace/callback" \
#      TIKTOKSHOP_APP_KEY="your-value" \
#      TIKTOKSHOP_APP_SECRET="your-value" \
#      TIKTOKSHOP_REDIRECT_URI="http://localhost:5173/dashboard/operasional/marketplace/callback" \
#      MARKETPLACE_ENCRYPTION_KEY="$ENCRYPTION_KEY"
#
# 3. WhatsApp Baileys Connector Setup:
#    a. Install Node.js dependencies: cd whatsapp-connector && npm install
#    b. Set up environment variables in whatsapp-connector/.env:
#       - SUPABASE_URL=https://<project-ref>.supabase.co
#       - SUPABASE_SERVICE_KEY=<service-role-key>
#       - WHATSAPP_ENCRYPTION_KEY=<32-byte-hex>
#    c. Run: node server.mjs
#    d. Update VITE_WHATSAPP_CONNECTOR_URL in frontend .env
#
# 4. Deploy edge functions (for compatibility):
#    supabase functions deploy marketplace-connect
#    supabase functions deploy marketplace-disconnect
#    supabase functions deploy marketplace-status
#    supabase functions deploy marketplace-oauth
#    supabase functions deploy marketplace-sync-inventory
#    supabase functions deploy marketplace-sync-orders
#    supabase functions deploy marketplace-sync-products
#    supabase functions deploy marketplace-webhook
#
#    # Google Business Profile:
#    supabase functions deploy google-business-connect
#    supabase functions deploy google-business-callback
#    supabase functions deploy google-business-status
#    supabase functions deploy google-business-reviews
#    supabase functions deploy google-business-posts
#    supabase functions deploy google-business-performance
#    supabase functions deploy google-business-disconnect
#
#    # Set Google Business Profile secrets:
#    supabase secrets set \
#      GOOGLE_OAUTH_CLIENT_ID="your-client-id" \
#      GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret" \
#      GOOGLE_OAUTH_REDIRECT_URI="https://<ref>.supabase.co/functions/v1/google-business-callback"
#
# 5. Apply database migration:
#    supabase db push
#    # or
#    supabase migration up
#
# ═══════════════════════════════════════════════════════════════════════════════
