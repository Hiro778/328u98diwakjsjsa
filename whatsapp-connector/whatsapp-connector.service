[Unit]
Description=WhatsApp Baileys Persistent Connector Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/whatsapp-connector
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=whatsapp-connector

# Load environment variables from .env
EnvironmentFile=/var/www/whatsapp-connector/.env

[Install]
WantedBy=multi-user.target
