# WhatsApp Baileys Connector - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# Supabase (Backend only - never exposed to frontend)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Encryption key for WhatsApp credentials (AES-256-GCM)
# Generate ONCE with: openssl rand -hex 32
# This key MUST be persistent - changing it invalidates all stored sessions
WHATSAPP_ENCRYPTION_KEY=<32-byte-hex-key>

# Server port (optional, default: 3001)
WHATSAPP_CONNECTOR_PORT=3001
